rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Call recordings — only child or their parent can read/write
    match /recordings/{childId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == childId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.parentChildId == childId);
      allow write: if request.auth != null && request.auth.uid == childId;
    }

    // Remote camera snapshots — only child device writes, parent reads
    match /snapshots/{childId}/{allPaths=**} {
      allow read: if request.auth != null &&
        (request.auth.uid == childId ||
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.parentChildId == childId);
      allow write: if request.auth != null && request.auth.uid == childId;
    }

    // App update APK folder: public read, no write from client
    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
