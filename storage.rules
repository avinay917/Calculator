rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isChildOrParent(childId) {
      return isAuthenticated() && (
        request.auth.uid == childId ||
        (firestore.exists(/databases/(default)/documents/users/$(childId)) &&
         firestore.get(/databases/(default)/documents/users/$(childId)).data.parentId == request.auth.uid) ||
        (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // Call recordings — child, linked parent, or admin can read/write/delete (Max 50MB)
    match /recordings/{childId}/{allPaths=**} {
      allow read: if isChildOrParent(childId);
      allow write: if isChildOrParent(childId) && (
        request.resource == null ||
        request.resource.size < 50 * 1024 * 1024
      );
    }

    // Remote camera snapshots — child, linked parent, or admin can read/write/delete (Max 5MB)
    match /snapshots/{childId}/{allPaths=**} {
      allow read: if isChildOrParent(childId);
      allow write: if isChildOrParent(childId) && (
        request.resource == null ||
        request.resource.size < 5 * 1024 * 1024
      );
    }

    // Gallery thumbnails — child uploads, parent reads (Max 500KB)
    match /thumbnails/{childId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource == null ||
        request.resource.size < 500 * 1024
      );
    }

    // Requested full gallery files / photos
    match /gallery_files/{childId}/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (
        request.resource == null ||
        request.resource.size < 50 * 1024 * 1024
      );
    }

    // App update APK folder: public read, admin write
    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Fallback: deny all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
