rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isParentOfChild(childId) {
      return request.auth != null && (request.auth.uid == childId || firestore.get(/databases/(default)/documents/users/$(childId)).data.parentId == request.auth.uid);
    }

    // Call recordings and stream clips stored under recordings/{childId}/{fileName}
    match /recordings/{childId}/{allPaths=**} {
      allow read: if isParentOfChild(childId);
      allow write: if request.auth != null && request.auth.uid == childId && request.resource.size < 100 * 1024 * 1024;
    }

    // Remote camera snapshots captured by child device
    match /snapshots/{childId}/{allPaths=**} {
      allow read: if isParentOfChild(childId);
      allow write: if request.auth != null && request.auth.uid == childId && request.resource.size < 15 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
    
    // Updates APK folder: public read so devices can download app update
    match /updates/{allPaths=**} {
      allow read: if true;
      allow write: if false; // Only allow deployment via Firebase Console or Admin SDK
    }
  }
}
