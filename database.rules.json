{
  "rules": {
    "users": {
      ".read": "auth != null",
      ".indexOn": ["parentId", "role", "childPairingCode", "email"],
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "admins": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "admin_broadcasts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "parent_settings": {
      "$parentId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "streams": {
      ".read": "auth != null",
      ".indexOn": ["status", "timestamp", "sessionId"],
      "$childUid": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "audio_live": {
      ".read": "auth != null",
