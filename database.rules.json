{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".validate": "newData.hasChildren(['uid', 'email', 'role'])"
      }
    },
    "requests": {
      ".read": "auth != null",
      "$childId": {
        ".write": "auth != null"
      }
    },
    "streams": {
      ".read": "auth != null",
      "$targetUid": {
        ".write": "auth != null"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "recordings": {
      "$childId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "app_update": {
      ".read": true,
      ".write": true
    },
    "device_health": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "feature_diagnostics": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    }
  }
}
