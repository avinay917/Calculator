{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('parentId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['role']) && (auth.uid === $uid ? newData.child('role').val() === data.child('role').val() || !data.child('role').exists() : true)"
      }
    },
    "streams": {
      "$childId": {
        ".read": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "recordings": {
      ".read": "auth != null",
      "$childId": {
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)"
      }
