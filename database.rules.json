      }
    },
    "pairing_codes": {
      "$code": {
        ".read": "auth != null && $code.matches(/^[0-9]{6}$/) && data.child('isUsed').val() != true && data.child('createdAt').isNumber() && now - data.child('createdAt').val() <= 600000",
        ".write": "auth != null && (data.exists() ? (data.child('parentUid').val() == auth.uid || (data.child('isUsed').val() != true && newData.child('linkedChildUid').val() == auth.uid && newData.child('isUsed').val() == true && newData.child('parentUid').val() == data.child('parentUid').val() && newData.child('createdAt').val() == data.child('createdAt').val())) : newData.child('parentUid').val() == auth.uid)",
        ".validate": "newData.child('parentUid').isString() && newData.child('parentUid').val() == (data.exists() ? data.child('parentUid').val() : auth.uid) && newData.child('createdAt').isNumber() && (!newData.child('isUsed').exists() || newData.child('isUsed').isBoolean()) && (!newData.child('linkedChildUid').exists() || newData.child('linkedChildUid').isString())"
      }
    },
