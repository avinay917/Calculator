{
  "rules": {
    "users": {
      ".read": "auth != null && query.orderByChild == 'parentId' && query.equalTo == auth.uid",
      ".indexOn": ["parentId", "role"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "parent_settings": {
      "$parentId": {
        ".read": "auth != null && auth.uid == $parentId",
        ".write": "auth != null && auth.uid == $parentId"
      }
    },
    "streams": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)"
      }
    },
    "audio_live": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null && (root.child('streams').child(auth.uid).child('sessionId').val() == $sessionId || root.child('users').child(auth.uid).child('role').val() == 'parent')",
        ".write": "auth != null && (root.child('streams').child(auth.uid).child('sessionId').val() == $sessionId || root.child('users').child(auth.uid).child('role').val() == 'parent')"
      }
    },
    "recordings": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".indexOn": ["timestamp"]
      }
    },
    "app_update": {
      ".read": true,
      ".write": false
    },
    "ice_servers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() == 'parent'"
