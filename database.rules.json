      ".indexOn": ["parentId", "role", "childPairingCode"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid || root.child('admins').child(auth.uid).val() == true || root.child('users').child(auth.uid).child('role').val() == 'admin')",
