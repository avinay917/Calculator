{
  "rules": {
    "users": {
      ".indexOn": ["parentId", "role"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid || root.child('users').child(auth.uid).child('parentId').val() == $uid)",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid || (!data.exists() && auth.uid == $uid))",
        ".validate": "newData.hasChildren(['role']) && newData.child('role').isString() && ((newData.child('role').val() == 'parent' || newData.child('role').val() == 'child') && (!data.exists() || newData.child('role').val() == data.child('role').val()))"
      }
    },
    "streams": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'parent' || root.child('users').child(auth.uid).child('role').val() == 'child')",
        ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() == 'parent' || root.child('users').child(auth.uid).child('role').val() == 'child')"
      }
