{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'parent')"
      }
    },
    "streams": {
      "$childId": {
        ".read": "auth != null && (auth.uid === $childId || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child(auth.uid).child('role').val() === 'parent')"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "recordings": {
      ".read": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'parent'",
      "$childId": {
        ".read": "auth != null && (auth.uid === $childId || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child(auth.uid).child('role').val() === 'parent')"
      }
    },
    "app_update": {
      ".read": true,
      ".write": true
    },
    "ice_servers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'parent'"
    },
    "device_health": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "feature_diagnostics": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'parent')",
        ".write": "auth != null && auth.uid === $uid"
