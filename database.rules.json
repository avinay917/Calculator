{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child(auth.uid).child('role').val() === 'parent')"
      }
    },
    "requests": {
      ".read": "auth != null",
      "$childId": {
        ".write": "auth != null"
      }
    },
    "streams": {
      ".read": "auth != null",
      "$targetUid": {
        ".write": "auth != null"
      }
    },
    "signaling": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "recordings": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$childId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "app_update": {
      ".read": true,
      ".write": true
    },
    "device_health": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    },
    "feature_diagnostics": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null"
      }
    }
  }
}
