{
  "rules": {
    "users": {
      ".indexOn": ["parentId", "role"],
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid || root.child('users').child(auth.uid).child('parentId').val() == $uid)",
        ".write": "auth != null && (auth.uid == $uid || root.child('users').child($uid).child('parentId').val() == auth.uid)",
        ".validate": "newData.hasChildren(['role']) && newData.child('role').isString() && (newData.child('role').val() == 'parent' || newData.child('role').val() == 'child')"
      }
    },
    "streams": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "recordings": {
      "$childUid": {
        ".read": "auth != null && (auth.uid == $childUid || root.child('users').child($childUid).child('parentId').val() == auth.uid)",
        ".write": "auth != null && auth.uid == $childUid",
        ".indexOn": ["timestamp"]
      }
    },
    "app_update": {
      ".read": true,
      ".write": false
    },
    "ice_servers": {
