{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid === $uid || root.child('users').child($uid).child('parentId').val() === auth.uid || (data.child('parentId').val() === '' || !data.child('parentId').exists()))"
      }
    },
    "streams": {
      "$childId": {
        ".read": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)"
      }
    },
    "signaling": {
      "$sessionId": {
        ".read": "auth != null && $sessionId.contains(auth.uid)",
        ".write": "auth != null && $sessionId.contains(auth.uid)"
      }
    },
    "recordings": {
      "$childId": {
        ".read": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)",
        ".write": "auth != null && (auth.uid === $childId || root.child('users').child($childId).child('parentId').val() === auth.uid)"
      }
    },
    "app_update": {
      ".read": true,
      ".write": "(auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin') || (newData.hasChildren(['versionCode', 'apkUrl', 'versionName']) && newData.child('apkUrl').isString() && newData.child('apkUrl').val().startsWith('https://github.com/avinay917/Calculator/releases/download/latest/'))"
    },
    "ice_servers": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
