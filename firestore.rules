rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isLinkedParent(childId) {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(childId)).data.parentId == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'parent';
    }

    function isParentOfChild(childId) {
      return isOwner(childId) || isLinkedParent(childId);
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isParentOfChild(userId) || (isAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.parentId == userId);
      allow write: if isOwner(userId) || isLinkedParent(userId);
    }

    // Child historical subcollections
    match /call_logs/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /sms_logs/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /web_history/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /network_history/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /package_events/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /security_alerts/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /location_history/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /recordings/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /whatsapp_logs/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /notifications/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /clipboard_logs/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /keystrokes/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /app_usage/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /file_explorer/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /youtube_history/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /media_gallery/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    match /media_items/{childId}/items/{docId} {
      allow read: if isParentOfChild(childId);
      allow write: if isOwner(childId);
    }

    // Fallback: deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
